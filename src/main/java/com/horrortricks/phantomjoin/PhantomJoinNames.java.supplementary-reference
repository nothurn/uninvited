package com.horrortricks.phantomjoin;

import java.util.ArrayList;
import java.util.Collections;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import net.minecraft.util.RandomSource;

public final class PhantomJoinNames {
   private static final String[] SYSTEM_PATTERNS = new String[]{
      "Player_%d", "Guest_%d", "User_%d", "Account_%d", "Unknown_%d", "temp_user_%d", "test_%d", "NewPlayer%d", "guest%d", "Player%d"
   };
   private static final String[] COMMON_NAMES = new String[]{
      "Ethan",
      "Sarah",
      "Jacob",
      "Emily",
      "Noah",
      "Olivia",
      "Liam",
      "Ava",
      "Mason",
      "Sophia",
      "Lucas",
      "Mia",
      "Aiden",
      "Chloe",
      "Owen",
      "Grace",
      "Caleb",
      "Zoe",
      "Ryan",
      "Ella",
      "Nathan",
      "Hannah",
      "Tyler",
      "Dylan"
   };
   private static final Map<Character, Character> LOOKALIKES = buildLookalikes();

   private PhantomJoinNames() {
   }

   public static String generate(RandomSource random, String currentPlayerName) {
      boolean canDoppelganger = currentPlayerName != null && !currentPlayerName.isBlank();
      int strategy = random.nextInt(3);
      if (strategy == 0 && canDoppelganger) {
         return distort(random, currentPlayerName);
      }

      if (strategy == 1) {
         return systemLooking(random);
      }

      String base = COMMON_NAMES[random.nextInt(COMMON_NAMES.length)];
      return distort(random, base);
   }

   private static String distort(RandomSource random, String base) {
      switch (random.nextInt(4)) {
         case 0:
            return appendTrailingChar(random, base);
         case 1:
            return doubleRandomLetter(random, base);
         case 2:
            return dropRandomLetter(random, base);
         default:
            String swapped = swapLookalike(random, base);
            return swapped != null ? swapped : appendTrailingChar(random, base);
      }
   }

   private static String appendTrailingChar(RandomSource random, String base) {
      return random.nextBoolean() ? base + "_" : base + random.nextInt(10);
   }

   private static String doubleRandomLetter(RandomSource random, String base) {
      int index = random.nextInt(base.length());
      char c = base.charAt(index);
      return base.substring(0, index + 1) + c + base.substring(index + 1);
   }

   private static String dropRandomLetter(RandomSource random, String base) {
      if (base.length() <= 1) {
         return appendTrailingChar(random, base);
      }

      int index = random.nextInt(base.length());
      return base.substring(0, index) + base.substring(index + 1);
   }

   private static String swapLookalike(RandomSource random, String base) {
      List<Integer> candidates = new ArrayList<>();

      for (int i = 0; i < base.length(); i++) {
         if (LOOKALIKES.containsKey(base.charAt(i))) {
            candidates.add(i);
         }
      }

      if (candidates.isEmpty()) {
         return null;
      }

      int index = candidates.get(random.nextInt(candidates.size()));
      char replacement = LOOKALIKES.get(base.charAt(index));
      return base.substring(0, index) + replacement + base.substring(index + 1);
   }

   private static String systemLooking(RandomSource random) {
      String pattern = SYSTEM_PATTERNS[random.nextInt(SYSTEM_PATTERNS.length)];
      int digits = 2 + random.nextInt(3);
      int max = (int)Math.pow(10.0, digits) - 1;
      int number = random.nextInt(max + 1);
      String formatted = String.format("%0" + digits + "d", number);
      return pattern.replace("%d", formatted);
   }

   private static Map<Character, Character> buildLookalikes() {
      Map<Character, Character> map = new HashMap<>();
      map.put('o', '0');
      map.put('O', '0');
      map.put('l', '1');
      map.put('i', '1');
      map.put('I', '1');
      map.put('s', '5');
      map.put('S', '5');
      map.put('e', '3');
      map.put('E', '3');
      map.put('a', '4');
      map.put('A', '4');
      map.put('b', '8');
      map.put('B', '8');
      return Collections.unmodifiableMap(map);
   }
}
